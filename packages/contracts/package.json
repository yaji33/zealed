{
  "name": "@zealed/contracts",
  "description": "fhEVM contracts for Zealed confidential prize savings",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "license": "BSD-3-Clause-Clear",
  "dependencies": {
    "@fhevm/mock-utils": "^0.4.2",
    "@fhevm/solidity": "^0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "encrypted-types": "^0.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.30",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "^4.5.0",
    "chai-as-promised": "^8.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "ethers": "^6.16.0",
    "globals": "^17.6.0",
    "hardhat": "^2.28.6",
    "hardhat-deploy": "^0.11.45",
    "hardhat-gas-reporter": "^2.3.0",
    "mocha": "^11.7.5",
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1",
    "rimraf": "^6.1.3",
    "solhint": "^6.2.1",
    "solidity-coverage": "^0.8.17",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "scripts": {
    "clean": "rimraf ./fhevmTemp ./artifacts ./cache ./coverage ./types ./coverage.json ./dist && pnpm run typechain",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "build": "pnpm run compile",
    "coverage": "cross-env SOLIDITY_COVERAGE=true hardhat coverage --solcoverjs ./.solcover.js --temp artifacts --testfiles \"test/**/*.ts\" && pnpm run typechain",
    "lint": "pnpm run lint:sol && pnpm run lint:ts && pnpm run prettier:check",
    "lint:sol": "solhint --max-warnings 0 \"contracts/**/*.sol\"",
    "lint:ts": "eslint .",
    "postcompile": "pnpm run typechain",
    "prettier:check": "prettier --check \"**/*.{js,json,md,sol,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,sol,ts,yml}\"",
    "test": "hardhat test",
    "test:sepolia": "hardhat test --network sepolia",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.ts --network sepolia",
    "deploy:sepolia:resume": "hardhat run scripts/resume-deploy-sepolia.ts --network sepolia",
    "deploy:multivault:sepolia": "hardhat run scripts/deploy-multivault-sepolia.ts --network sepolia",
    "vault:add:sepolia": "hardhat run scripts/add-vault-sepolia.ts --network sepolia",
    "prizes:fund:sepolia": "hardhat run scripts/fund-prize-pools-sepolia.ts --network sepolia",
    "keeper:sepolia": "hardhat run scripts/keeper-sepolia.ts --network sepolia",
    "smoke:sepolia": "hardhat run scripts/smoke-sepolia.ts --network sepolia",
    "smoke:draw:sepolia": "hardhat run scripts/smoke-draw-sepolia.ts --network sepolia"
  }
}
